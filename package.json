{
  "name": "work-checklist",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Browse and edit a DingTalk AI Table inside DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wealne/work-checklist.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dingtalk",
    "alidocs",
    "spreadsheet"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
